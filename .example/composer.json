{
    "name": "precision-soft/doctrine-utility-example",
    "description": "The product catalogue of a shop - repositories with generic, custom and join filters, typed criteria with keyset paging, the MySQL JSON functions and index hints, and a repricing service that holds a named lock - whose test suite exercises every public capability of precision-soft/doctrine-utility on the real engines",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "doctrine/dbal": "^4.0",
        "doctrine/orm": "^3.0",
        "precision-soft/doctrine-utility": "*@dev",
        "symfony/doctrine-bridge": "^7.0 || ^8.0",
        "symfony/uid": "^7.0 || ^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5",
        "symfony/phpunit-bridge": "^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "PrecisionSoft\\Doctrine\\Utility\\Example\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PrecisionSoft\\Dev\\PhpStan\\": "../.dev/phpstan/",
            "PrecisionSoft\\Doctrine\\Utility\\Example\\Test\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../",
            "options": {
                "symlink": true
            }
        }
    ],
    "scripts": {
        "test": "simple-phpunit --fail-on-skipped",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "check": [
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "platform": {
            "php": "8.2"
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
